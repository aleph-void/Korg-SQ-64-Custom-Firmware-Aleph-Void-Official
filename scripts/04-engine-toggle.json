{
  "format": "sq64-ui-script",
  "version": 1,
  "name": "AV aggregate 04: SHIFT+track toggles each track's engine",
  "actions": [
    {"type": "power-on", "mode": "normal"},
    {"type": "wait", "ms": 20000},
    {"type": "button", "control": "shift", "down": true},
    {"type": "press", "control": "trackA", "ms": 150},
    {"type": "button", "control": "shift", "down": false},
    {"type": "wait", "ms": 5000},
    {"type": "button", "control": "shift", "down": true},
    {"type": "press", "control": "trackD", "ms": 150},
    {"type": "button", "control": "shift", "down": false},
    {"type": "wait", "ms": 3000},
    {"type": "press", "control": "play", "ms": 150},
    {"type": "wait", "ms": 6000},
    {"type": "button", "control": "shift", "down": true},
    {"type": "press", "control": "trackA", "ms": 150},
    {"type": "button", "control": "shift", "down": false},
    {"type": "wait", "ms": 4000},
    {"type": "press", "control": "stop", "ms": 150},
    {"type": "wait", "ms": 1000}
  ]
}
